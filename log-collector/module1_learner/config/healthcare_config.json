{
    "server": "healthcare",
    "log_format": {
        "delimiter": "|",
        "parts": ["timestamp", "component", "user_id", "message"],
        "timestamp_format": "%Y%m%d-%H:%M:%S"
    },
    "state_variables": {
        "step_count": {
            "pattern": "onStandStepChanged (\\d+)",
            "type": "incrementing_counter"
        },
        "total_calories": {
            "pattern": "totalCalories=(\\d+)",
            "type": "calculated"
        },
        "altitude": {
            "pattern": "totalAltitude=(\\d+)",
            "type": "constant"
        }
    },
    "causal_chains": {
        "step_update": [
            "onStandStepChanged",
            "setTodayTotalDetailSteps",
            "calculateCalories",
            "REPORT"
        ]
    }
}
